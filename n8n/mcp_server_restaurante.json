        "nodeCredentialType": "supabaseApi",
        "method": "GET",
        "url": "https://nqytcqambzznviybguxf.supabase.co/rest/v1/ingredientes?select=ingrediente,unidad,stock,stock_minimo&order=ingrediente.asc"
